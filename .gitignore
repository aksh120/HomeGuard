*.iml
.gradle/
.kotlin/
build/
**/build/
/local.properties
local.properties
/.idea/
.idea/
.DS_Store
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# Supabase CLI local state. .temp holds a machine-local project link and is
# generated by `supabase link`; it is not source.
supabase/.temp/
.env
.env.*
!.env.example

# `npx supabase` installs the CLI locally. That is tooling, not source.
node_modules/
package-lock.json

# Firebase client config (Phase 4). Not a secret in the cryptographic sense, but it is
# per-project and per-build-type, and this repository keeps release credentials out of git by
# injecting them from CI, so these follow the same convention. The google-services plugin is applied
# only when one of these exists; see app/build.gradle.kts.
google-services.json
app/src/debug/google-services.json
app/src/release/google-services.json

# Firebase service account keys. Unlike google-services.json these ARE real credentials: the private
# key in one can mint OAuth tokens for the project and send arbitrary push to any device registered
# against it. They belong in Supabase function secrets only.
*firebase-adminsdk*.json
service-account*.json
serviceaccount*.json

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Essential hardware & networking permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Phase 5: a caregiver-raised alarm has to sound from a locked, closed app. Nothing else is
      sufficient: a background MediaPlayer is suspended within seconds, and the poll fallback only
      runs every 15 minutes.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      Shows the alarm over the lock screen rather than as a silent notification. Declared but not
      assumed: on API 34+ Android grants this only to calling/alarm-category apps or by user
      action, and RemoteAlarmService's notification stands on its own if it is withheld.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!--
      Android 14+ revokes WAKE_LOCK from apps that do not declare it, and without it a high-priority
      FCM message cannot reliably wake the CPU to start the foreground service.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Flashlight torch (camera is optional so devices without rear camera still install) -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <!--
      Declared alongside the CAMERA permission. Declaring the permission without the matching
      hardware feature makes device and store filtering assume a camera is present, which would hide
      HomeGuard from camera-less devices and tablets — exactly the devices most likely to be sitting
      on a kitchen wall. required="false" because the torch is an extra, not the product.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!--
      CAMERA is requested only when the user toggles the flashlight. No microphone permission:
      the master specification explicitly excludes microphone access, so acoustic smoke-alarm
      detection has been removed rather than made opt-in.
    -->
    <uses-permission
        android:name="android.permission.CAMERA"
        android:required="false" />

    <!--
        Backup is disabled: this app stores medical details, home addresses, and contact numbers
        in a local database and DataStore. Copying that off-device via adb backup would break the
        sandboxed-storage guarantee.
    -->
    <application
        android:name=".HomeGuardApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.HomeGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".core.hardware.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Phase 4: receives caregiver alerts while backgrounded. exported is false because nothing
          outside the app may bind to it; FCM delivery does not require it to be exported.
        -->
        <service
            android:name=".core.notifications.HomeGuardMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Phase 5: sounds a caregiver-raised alarm. Exported is false, so no other app can start or
          stop it; the Stop action arrives as an explicit intent from our own notification.

          specialUse rather than mediaPlayback: this is not media playback, but Android offers no
          more accurate type for a safety alarm, and declaring the wrong one would be inaccurate too.
        -->
        <service
            android:name=".core.notifications.RemoteAlarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Sounds a caregiver-raised safety alarm on a locked phone, where the app
                    cannot hold a foreground activity and a background audio session would be suspended." />
        </service>

        <!--
          Scheduled safety check. Exported is false and the action is internal, so nothing outside
          the app can trigger a check-in prompt.
        -->
        <receiver
            android:name=".core.checkin.CheckInAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.homeguard.action.CHECK_IN_DUE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
